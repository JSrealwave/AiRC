# Canonical public URL (www). Apex activeimagerecognition.com redirects to www.
NEXT_PUBLIC_SITE_URL=https://www.activeimagerecognition.com

# Displayed contact email and Resend "to" inbox
CONTACT_EMAIL=sales@activeimagerecognition.com

# Resend (server only — never expose to the client)
RESEND_API_KEY=
RESEND_FROM=AiRC <sales@activeimagerecognition.com>

# Optional extra POST after a successful email (CRM). Failure is logged, not shown to the user.
CONTACT_WEBHOOK_URL=
